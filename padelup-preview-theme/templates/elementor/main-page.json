{
    "version": "0.4",
    "title": "PadelUp - Main Page",
    "type": "page",
    "content": [
        {
            "id": "padelup-hero-section",
            "elType": "section",
            "settings": {
                "layout": "full_width",
                "background_background": "classic",
                "background_color": "#1a1a1a"
            },
            "elements": [
                {
                    "id": "padelup-hero-col",
                    "elType": "column",
                    "settings": {
                        "_column_size": 100
                    },
                    "elements": [
                        {
                            "id": "padelup-hero-widget",
                            "elType": "widget",
                            "widgetType": "padelup-hero",
                            "settings": {
                                "badge": "PREMIUM PADEL GEAR",
                                "title": "ИГРАЙ<br>ЛУЧШЕ.<br><span>ПОБЕЖДАЙ.</span>",
                                "subtitle": "Премиальная экипировка для падела",
